DJANGO_ENV=local
DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=storyteller
POSTGRES_USER=storyteller
POSTGRES_PASSWORD=storyteller

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=

KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_TEMPLATE=
AUTH_VERIFICATION_CODE_LENGTH=6
AUTH_VERIFICATION_CODE_EXPIRY_MINUTES=2

ARVAN_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.com
ARVAN_REGION_NAME=ir-thr-at1
ARVAN_ACCESS_KEY_ID=
ARVAN_SECRET_ACCESS_KEY=
ARVAN_STATIC_BUCKET=storyteller-static
ARVAN_MEDIA_BUCKET=storyteller-media
ARVAN_STATIC_CUSTOM_DOMAIN=
ARVAN_MEDIA_CUSTOM_DOMAIN=
ARVAN_STATIC_LOCATION=static
ARVAN_MEDIA_LOCATION=media
ARVAN_SIGNED_URL_EXPIRY_SECONDS=3600

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=5
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
JWT_ROTATION_STRATEGY=rotate
DJANGO_LOG_LEVEL=INFO
